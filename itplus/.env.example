# ════════════════════════════════════════════════════════════════════
#  ITPlus — Plataforma de Consulta Inteligente
#  Copia como ".env" en la raíz del proyecto
# ════════════════════════════════════════════════════════════════════

# App
APP_NAME=ITPlus Consulta Inteligente
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
DEBUG=true

# PostgreSQL + pgvector
DATABASE_URL=postgresql://itplus:itplus@localhost:5432/consulta_db

# Redis (Celery worker)
REDIS_URL=redis://localhost:6379/0

# LLM — los 3 motores (Asistente, ITPlusBot, RAG)
# Drivers compatibles con OpenAI: gemini | groq | openai | ollama
AI_DRIVER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
# Default: Gemini (Google AI Studio). Key gratis en https://aistudio.google.com/apikey
AI_MODEL=gemini-3.6-flash
AI_MAX_TOKENS=4096

# Embeddings locales (sentence-transformers, sin API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Almacenamiento de documentos
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# CORS
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Langfuse (opcional — observabilidad)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
