# ════════════════════════════════════════════════════════════════════
#  ITPlus — Plataforma de Consulta Inteligente
#  Copia como ".env" en la raíz del proyecto
# ════════════════════════════════════════════════════════════════════

# App
APP_NAME=ITPlus Consulta Inteligente
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
# Con DEBUG=true, Swagger (/api/docs), ReDoc (/api/redoc) y el schema OpenAPI
# (/api/openapi.json) quedan públicos sin autenticación (útil en desarrollo
# para explorar la API). Define DEBUG=false en cualquier entorno expuesto a
# internet o a personas fuera del equipo de desarrollo.
DEBUG=true

# PostgreSQL + pgvector
DATABASE_URL=postgresql://itplus:itplus@localhost:5432/consulta_db

# Redis (Celery worker)
REDIS_URL=redis://localhost:6379/0

# LLM — los 3 motores (Asistente, ITPlusBot, RAG)
# Drivers compatibles con OpenAI: gemini | groq | openai | ollama
# Default: Gemini (Google AI Studio). Saca tu API key gratis en https://aistudio.google.com/apikey
# Nota de privacidad: el tier gratis de Gemini puede usar tus prompts para entrenar; usa Tier 1 (con billing) si es sensible.
AI_DRIVER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
# gemini-2.5-flash ya no está disponible para cuentas nuevas (404).
# gemini-3.6-flash es el default actual; el free tier puede limitar ~20 req/día.
AI_MAX_TOKENS=4096
# Máximo tiempo de espera por respuesta del proveedor LLM (segundos).
AI_TIMEOUT_SECONDS=60

# Embeddings locales (sentence-transformers, sin API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Almacenamiento de documentos
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# CORS
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Seguridad / sesiones (defaults; editables desde panel admin)
API_TOKEN_EXPIRE_HOURS=24
SESSIONS_IDLE_MINUTES=30
SESSIONS_RETENTION_MONTHS=6

# Usuario admin inicial (sembrado por seed_admin.py al arrancar).
# Si los dejas vacíos/comentados se usa admin@itplus.cl / admin123 —
# SOLO para desarrollo local. En producción, define ambos con valores
# propios antes del primer arranque, o cambia la contraseña desde la UI
# apenas inicies sesión por primera vez.
# ADMIN_EMAIL=admin@itplus.cl
# ADMIN_PASSWORD=change-me-before-deploying

# Azure AD / Entra ID (inactivo hasta configurar backend + frontend)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Frontend build (Vite) — botón Microsoft solo si ambas están definidas:
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
# VITE_AZURE_REDIRECT_URI=http://localhost:3000

# Fase 3 — Conector ERP/API (dejar vacío hasta integrar)
# ERP_API_URL=
# ERP_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
